# Copie para .env e ajuste se necessário (o arquivo .env não vai para o Git).

# Conexão do backend com o MySQL do Docker Compose.
# A porta deve ser a mesma definida em MYSQL_PORT no .env da raiz.
DATABASE_URL=mysql+pymysql://app:app@localhost:3306/teatro

# Duração da reserva, em minutos (padrão: 10).
RESERVATION_MINUTES=10

# Origens liberadas para o frontend (separadas por vírgula).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
